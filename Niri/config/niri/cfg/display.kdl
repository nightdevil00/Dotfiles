// ────────────── Output Configuration ──────────────
// You can run `niri msg outputs` to get the correct name for your displays.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

// External monitor (Samsung C27F390) — on the left.
output "HDMI-A-4" {
    mode "1920x1080@60.000"
    scale 1
    position x=0 y=0
}

// Internal laptop panel — on the right.
output "eDP-1" {
    mode "1920x1080@60.003"
    scale 1
    position x=1920 y=0
}
